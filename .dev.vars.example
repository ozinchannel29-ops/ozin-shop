# Salin file ini menjadi ".dev.vars" (di komputer) atau ".env" (di VPS), lalu isi kuncinya.
# File itu TIDAK ikut ke GitHub. Kunci yang dikosongkan = bagian itu berjalan dalam mode simulasi.

# Password halaman admin (/admin). Wajib diisi begitu ada kunci asli di bawah.
ADMIN_PASSWORD=

# Supplier yang dipakai: digiflazz | vipayment
SUPPLIER=digiflazz

# Digiflazz → Atur Koneksi → API (username, API key, whitelist IP server, webhook)
# development = pakai Development Key (transaksi uji), production = pakai Production Key
DIGIFLAZZ_MODE=development
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# VIPayment (cadangan, dipakai bila SUPPLIER=vipayment)
VIP_API_ID=
VIP_API_KEY=

# Payment gateway yang dipakai: doku | tripay
PAYMENT=doku

# DOKU → Back Office → Integration → API Keys (Client ID & Secret Key). sandbox dulu, lalu production
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# Tripay (cadangan, dipakai bila PAYMENT=tripay) → Merchant → API & Integrasi
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
